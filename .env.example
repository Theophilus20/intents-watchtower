# Watcher identity (register the public key with add_watcher on the contract)
WATCHER_ACCOUNT_ID=w1.watchtower.testnet
WATCHER_SECRET_KEY=ed25519:...
# Optional relayer that pays gas for submit_report (defaults to the watcher account)
RELAYER_ACCOUNT_ID=
RELAYER_SECRET_KEY=
# Optional: persist history, alerts and engine state (PGlite directory)
WATCHTOWER_PGLITE_DIR=./data/w1
# Optional: NEAR AI explanations (falls back to deterministic templates)
NEAR_AI_API_KEY=
# Optional: Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STATUS_PAGE_URL=
